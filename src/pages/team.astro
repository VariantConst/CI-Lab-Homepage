---
// 导入组件和需要的脚本或样式
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchData } from "../lib/fetchTeam";
import TeamCard from "../components/team/TeamCard.astro";
import TeamModal from "../components/team/TeamModal.astro";

// 获取团队成员数据
const data = await fetchData();

// 计算不同类型成员的数量
// Faculty and staff are grouped by Contentful tags. Add the `faculty` or
// `staff` tag to a team entry in Contentful to control its section.
const hasTag = (item: (typeof data.items)[number], tag: string) =>
  item.metadata?.tags?.some((itemTag) => itemTag.sys.id === tag) ?? false;

const sortByPriority = (
  a: (typeof data.items)[number],
  b: (typeof data.items)[number]
) => {
  const ap = Number(a.fields.priority ?? 0);
  const bp = Number(b.fields.priority ?? 0);
  if (ap !== bp) return bp - ap;
  return String(a.fields.name ?? "").localeCompare(String(b.fields.name ?? ""));
};

const facultyMembers = data.items
  .filter((item) => hasTag(item, "faculty"))
  .sort(sortByPriority);
const staffMembers = data.items
  .filter((item) => hasTag(item, "staff"))
  .sort(sortByPriority);
// The principal investigator is rendered separately above the Faculty section.
const num_faculty = facultyMembers.length + 1;
const num_staff = staffMembers.length;

const num_phD = data.items.filter(
  (item) =>
    hasTag(item, "phD") && !hasTag(item, "faculty") && !hasTag(item, "staff")
).length;
const num_master = data.items.filter(
  (item) => hasTag(item, "master") && !hasTag(item, "faculty") && !hasTag(item, "staff")
).length;

// 定义不同类型成员的标题和卡片大小
const people_types = ["phD", "master", "alumni"];
const people_type_to_title = {
  phD: "PhD Students",
  master: "Master Students",
  alumni: "Alumni",
};
const people_type_to_level = {
  phD: "medium",
  master: "medium",
  alumni: "small",
};

// 将数字转换为英文单词的函数
function numberToWords(num: number) {
  const ones = [
    "",
    "one",
    "two",
    "three",
    "four",
    "five",
    "six",
    "seven",
    "eight",
    "nine",
  ];
  const teens = [
    "ten",
    "eleven",
    "twelve",
    "thirteen",
    "fourteen",
    "fifteen",
    "sixteen",
    "seventeen",
    "eighteen",
    "nineteen",
  ];
  const tens = [
    "",
    "",
    "twenty",
    "thirty",
    "forty",
    "fifty",
    "sixty",
    "seventy",
    "eighty",
    "ninety",
  ];

  if (num < 0 || num > 99 || !Number.isInteger(num)) {
    return "invalid number";
  }

  if (num < 10) {
    return ones[num];
  } else if (num < 20) {
    return teens[num - 10];
  } else {
    const tensPlace = Math.floor(num / 10);
    const onesPlace = num % 10;
    return tens[tensPlace] + (onesPlace !== 0 ? "-" + ones[onesPlace] : "");
  }
}
---

<BaseLayout>
  <main>
    <TeamModal />
    <div class="mx-auto">
      <div class="py-12 px-8">
        <h2 class="text-4xl font-light tracking-tight sm:text-5xl mb-8">
          Group Organization
        </h2>
        <div class="mx-auto">
          <p class="text-xl mild leading-relaxed text-left">
            PKU Camera Intelligence Lab currently has {numberToWords(num_faculty)}{" "}
            faculty member{num_faculty === 1 ? "" : "s"} and the following full-time
            members (including co-supervision and 2027 Fall incoming): {numberToWords(num_staff)}{" "}
            postdocs, {numberToWords(num_phD)} doctoral students, {numberToWords(num_master)}{" "}
            master students, plus several visiting students / undergraduate research interns
            as part-time members.
          </p>
        </div>
      </div>
      <div class="border-t border-gray-200 dark:border-gray-700"></div>
    </div>

    <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <div
        class="text-3xl sm:text-4xl md:text-5xl font-light text-center text-gray-800 dark:text-gray-200 mb-12"
      >
        Principal Investigator
      </div>
      <div
        class="flex flex-col 2xl:flex-row 2xl:gap-24 items-center justify-center gap-16"
      >
        <div class="w-full lg:w-1/3 max-w-96">
          <div class="aspect-w-5 aspect-h-7 rounded-lg overflow-hidden">
            <img
              src="https://images.ctfassets.net/yreyglvi5sud/1svg4PhZ7aDMEHjA92k0yh/c5ba769ad3b5ab64d65e305577ffc0b9/boxin-shi-original.jpeg"

              alt="Boxin Shi"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
        <div class="w-full lg:w-2/3">
          <div
            class="text-xl sm:text-2xl md:text-3xl font-semibold text-gray-800 dark:text-gray-200 mb-2"
          >
            Boxin Shi / 施柏鑫
          </div>
          <div
            class="text-base sm:text-lg text-gray-600 dark:text-gray-400 mb-2"
          >
            Associate Professor with Tenure / 研究员 (博士生导师)
          </div>
          <div
            class="text-base md:text-lg text-blue-600 dark:text-blue-400 mb-6 hover:cursor-pointer"
          >
            <a id="emailLink">Email address</a>
          </div>

          <div
            class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed"
          >
            Boxin Shi is currently a Boya Young Fellow Associate Professor (with tenure) and Research Professor at Peking University, where he leads the Camera Intelligence Lab (https://camera.pku.edu.cn). He received the PhD degree from the University of Tokyo and did postdoc research at MIT Media Lab. His research interests are computational photography, computer vision, generative AI, and embodied AI. His papers were awarded as Best Paper, Runners-Up at CVPR’24/ICCP’15 and selected as Best Paper, Candidate at CVPR’26/3DV’26/ICCV’15. He has received the Okawa Foundation Research Grant (2021) and IJCV Outstanding Editorial Board Members Award (2025). He serves as the Editor-in-Chief of IJCV, the associate editor of TPAMI, and (lead) area chairs of CVPR/ICCV/ECCV. He is a Distinguished Lecturer of APSIPA, a Distinguished Member of CCF, and a Senior Member of IEEE.
          </div>
        </div>
      </div>
    </div>

    <!-- Faculty and staff -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <section>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-center text-gray-800 dark:text-gray-200 mb-12">
            Faculty
          </h2>
          <div class="flex flex-row flex-wrap gap-12 justify-center">
            {facultyMembers.map((item) => {
              const displayData = {
                ...item.fields,
              };
              return (
                <div
                  id={`people-${item.fields.name}`}
                  class="faculty"
                  data-fields={JSON.stringify(displayData)}
                >
                  <TeamCard data={displayData} level="large" showPosition={true} />
                </div>
              );
            })}
          </div>
        </section>

        <section>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-center text-gray-800 dark:text-gray-200 mb-12">
            Staff
          </h2>
          <div class="flex flex-row flex-wrap gap-12 justify-center">
            {staffMembers.map((item) => {
              const displayData = {
                ...item.fields,
              };
              return (
                <div
                  id={`people-${item.fields.name}`}
                  class="staff"
                  data-fields={JSON.stringify(displayData)}
                >
                  <TeamCard
                    data={displayData}
                    level="large"
                    showPosition={true}
                  />
                </div>
              );
            })}
          </div>
        </section>
      </div>
    </div>

    <!-- 渲染其他类型的团队成员 -->
    {
      people_types.map((type) => (
        <div class="flex items-center justify-center">
          <div class="mb-16">
            <div class="text-3xl sm:text-4xl md:text-5xl font-light text-center text-gray-800 dark:text-gray-200 m-12">
              {people_type_to_title[type as keyof typeof people_type_to_title]}
              {type === "alumni" && (
                <button
                  id="alumniToggleButton"
                  class="ml-4 px-3 py-2 bg-gray-200 dark:bg-gray-700 rounded-md text-sm focus:outline-none hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors duration-200"
                >
                  <svg
                    id="alumniToggleIcon"
                    class="w-4 h-4 transform rotate-0 transition-transform duration-200"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </button>
              )}
            </div>
            <div
              id={`${type}Container`}
              class={`${type === "alumni" ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mx-auto" : "flex flex-row flex-wrap gap-12 justify-center"}`}
              style={type === "alumni" ? "display:none" : "display:flex"}
            >
              {data.items
                .filter(
                  (item) =>
                    hasTag(item, type) &&
                    !hasTag(item, "faculty") &&
                    !hasTag(item, "staff")
                )
                .sort((a, b) => {
                  // year comparison (alumni: descending, others: ascending)
                  const ay = Number(a.fields.year ?? 0);
                  const by = Number(b.fields.year ?? 0);
                  if (ay !== by) {
                    return type === "alumni" ? by - ay : ay - by;
                  }

                  // same year -> compare priorities
                  const ap = Number(a.fields.priority ?? 0);
                  const bp = Number(b.fields.priority ?? 0);

                  if (type === "alumni") {
                    // use priorityAlumni unless it's missing or equals 12 (sentinel -> fallback)
                    const aPA = a.fields.priorityAlumni;
                    const bPA = b.fields.priorityAlumni;
                    const aUseFallback = aPA === undefined || Number(aPA) === 12;
                    const bUseFallback = bPA === undefined || Number(bPA) === 12;

                    const aEffective = aUseFallback ? ap : Number(aPA);
                    const bEffective = bUseFallback ? bp : Number(bPA);

                    if (aEffective !== bEffective) return bEffective - aEffective;
                  } else {
                    if (ap !== bp) return bp - ap; // non-alumni: priority desc
                  }

                  // final deterministic tiebreaker
                  return String(a.fields.name ?? "").localeCompare(String(b.fields.name ?? ""));
                })
                .map((item) => (
                  <div
                    id={`people-${item.fields.name}`}
                    class={type}
                    data-fields={JSON.stringify(item.fields)}
                  >
                    <TeamCard
                      data={item.fields}
                      level={people_type_to_level[type as keyof typeof people_type_to_level]}
                      showEducationCurrent={type === "alumni"}
                    />
                  </div>
                ))}
            </div>
          </div>
        </div>
      ))
    }
  </main>
</BaseLayout>

<!-- 处理团队成员卡片的点击事件 -->
<script is:inline type="module">
  // 切换元素的显示状态并设置属性值
  function toggleDisplayAndSetProperty(elementId, content, propertyType) {
    const element = document.getElementById(elementId);
    if (element) {
      element.style.display = content ? "block" : "none";
      if (content) {
        if (propertyType === "href") {
          element.href = content;
        } else if (propertyType === "innerHTML") {
          element.innerHTML = content;
        }
      }
    }
  }

  function setModalName(name, nameCn) {
    const element = document.getElementById("modal-name");
    if (!element) return;

    element.replaceChildren();

    const nameSpan = document.createElement("span");
    nameSpan.className = "whitespace-nowrap";
    nameSpan.textContent = name || "";

    const separatorSpan = document.createElement("span");
    separatorSpan.setAttribute("aria-hidden", "true");
    separatorSpan.textContent = " / ";

    const nameCnSpan = document.createElement("span");
    nameCnSpan.className = "whitespace-nowrap";
    nameCnSpan.textContent = nameCn || "";

    element.append(nameSpan, separatorSpan, nameCnSpan);
  }

  // 为非 alumni 类型的团队成员卡片添加点击事件
  const peopleElements = document.querySelectorAll(
    '[id^="people-"]:not(.alumni)'
  );
  peopleElements.forEach((element) => {
    // 在每个元素内部查找具有 "people-portrait" 类的子元素
    const portraitElement = element.querySelector(".people-portrait");

    // 如果找到了 "people-portrait" 元素,则添加点击事件
    if (portraitElement) {
      portraitElement.addEventListener("click", function () {
        // 在这里编写点击事件的处理逻辑
        console.log("Clicked on portrait:", portraitElement);
        // 可以在这里执行其他操作
        const data = JSON.parse(element.dataset.fields);
        const modal = document.getElementById("modal");
        const overlay = document.getElementById("overlay_team");

        modal.style.display = "block";
        overlay.style.display = "block";

        setModalName(data.name, data.nameCn);

        toggleDisplayAndSetProperty(
          "modal-educationCurrent",
          data.educationCurrent,
          "innerHTML"
        );
        toggleDisplayAndSetProperty(
          "modal-educationPrevious",
          data.educationPrevious,
          "innerHTML"
        );
        toggleDisplayAndSetProperty(
          "modal-educationNext",
          data.educationNext ? "Next: " + data.educationNext : null,
          "innerHTML"
        );
        toggleDisplayAndSetProperty("modal-homepage", data.homepage, "href");

        document.getElementById("modal-image").src = data.imageLink
          ? data.imageLink
          : data.image
            ? data.image.fields.file.url
            : "https://images.ctfassets.net/yreyglvi5sud/4usdd18KLnyLugCgzJU4Od/b6534d65f0f472b1904fbbc1e9ed7240/logo_icon.png";
      });
    }
  });

  // 处理 alumni 类型的展开/折叠按钮点击事件
  const alumniToggleButton = document.getElementById("alumniToggleButton");
  const alumniToggleIcon = document.getElementById("alumniToggleIcon");
  const alumniContainer = document.getElementById("alumniContainer");

  alumniToggleButton.addEventListener("click", function () {
    alumniContainer.style.display =
      alumniContainer.style.display === "none" ? "grid" : "none";
    alumniToggleIcon.classList.toggle("rotate-180");
  });

  // 点击模态框外部区域关闭模态框
  const modal = document.getElementById("modal");
  const overlay = document.getElementById("overlay_team");

  overlay.addEventListener("click", function () {
    modal.style.display = "none";
    overlay.style.display = "none";
  });
</script>

<!-- 隐藏显示email -->
<script is:inline type="module">
  function rot13(str) {
    return str.replace(/[a-zA-Z]/g, function (c) {
      return String.fromCharCode(
        (c <= "Z" ? 90 : 122) >= (c = c.charCodeAt(0) + 13) ? c : c - 26
      );
    });
  }
  document.addEventListener("DOMContentLoaded", function () {
    var emailLink = document.getElementById("emailLink");
    var originalText = emailLink.innerText;
    var timer = null;
    function showEmail() {
      emailLink.innerText = rot13("fuvobkva@cxh.rqh.pa");
      emailLink.style.cursor = "default";
    }
    function hideEmail() {
      emailLink.innerText = originalText;
      emailLink.style.cursor = "pointer";
    }
    emailLink.addEventListener("mouseenter", function () {
      clearTimeout(timer);
      showEmail();
    });
    emailLink.addEventListener("mouseleave", function () {
      timer = setTimeout(hideEmail, 5000);
    });
    emailLink.addEventListener("click", function (event) {
      event.preventDefault();
      clearTimeout(timer);
      showEmail();
      timer = setTimeout(hideEmail, 5000);
    });
  });
</script>
